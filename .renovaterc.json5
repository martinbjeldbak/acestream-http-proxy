{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", ":timezone(Australia/Sydney)"],
  packageRules: [
    {
      description: "Pin base Python image to the 3.10 line. AceStream ships prebuilt cp310 wheels/eggs and compiled extensions that won't load on other Python versions.",
      matchManagers: ["dockerfile"],
      matchPackageNames: ["/python/"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      description: "apsw and multidict dropped Python 3.10 support (apsw 3.54.1.0 and multidict 7.2.1 require Python >= 3.11, which breaks the build on the pinned 3.10 base image). Keep them on the newest releases that still ship cp310 wheels or pure Python wheels.",
      matchPackageNames: ["apsw"],
      allowedVersions: "<=3.54.0.0",
    },
    {
      description: "See the apsw rule above.",
      matchPackageNames: ["multidict"],
      allowedVersions: "<=7.1.0",
    },
    {
      description: "pycparser 3.12 requires Python >= 3.11 (3.11 requires >= 3.10). cffi pulls it in transitively, so a lockfile-only bump breaks `uv pip install` on the pinned 3.10 base image.",
      matchPackageNames: ["pycparser"],
      allowedVersions: "<=3.11",
    },
    {
      description: "Track unreleased commits of dockerhub-description. Upstream only publishes tagged releases, so the tagged release is stale while dist/ on main keeps the node24 runtime current.",
      matchManagers: ["github-actions"],
      matchPackageNames: ["peter-evans/dockerhub-description"],
      versioning: "git",
      pinDigests: false,
    },
  ],
}
